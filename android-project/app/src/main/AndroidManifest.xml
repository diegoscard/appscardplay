<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android TV / Google TV Requirements -->
    <!-- Leanback is required for TV UI, set required=false for broad compatibility with TV boxes -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Pure Remote control: touch screen is NOT required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Gamepad / D-Pad support -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:name=".ScardPlayApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/ic_launcher_banner"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScardPlayIptv"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard"
            android:theme="@style/Theme.ScardPlayIptv">

            <!-- Standard Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV / Google TV Leanback Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
